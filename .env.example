# Firebase config values
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""
ENABLE_HMR="false"

# Google OAuth / calendar client id
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_FIREBASE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Gemini API key (can be supplied directly or retrieved from Google Secret Manager)
# In Google Secret Manager, create a secret named 'Gemini_Api_Key' or 'GEMINI_API_KEY'
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Maps API key (can be supplied directly or retrieved from Google Secret Manager)
# In Google Secret Manager, create a secret named 'GOOGLE_MAPS_API_KEY' or 'Google_Maps_Api_Key'
GOOGLE_MAPS_API_KEY=""

# Optional: Google Cloud Project ID for Secret Manager retrieval (defaults to Cloud Run project)
GCP_PROJECT_ID=""

# App URL
APP_URL="MY_APP_URL"
